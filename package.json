{
  "name": "playwright-tests-framework",
  "version": "1.0.0",
  "description": "Advanced Playwright Test Automation Framework with concurrent execution, smart element handling, and production-ready features",
  "main": "dist/index.js",
  "scripts": {
    "test": "playwright test",
    "test:parallel": "playwright test --workers=4",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "build": "tsc",
    "lint": "eslint src/**/*.ts",
    "report": "playwright show-report"
  },
  "keywords": [
    "playwright",
    "automation",
    "testing",
    "concurrent",
    "watcher"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "@types/node": "^20.10.0",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "winston": "^3.11.0"
  }
}
