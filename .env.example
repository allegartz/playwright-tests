# Environment Configuration Example
# Copy this file to .env and update with your test values

# Base URL for testing (defaults to Playwright demo site)
BASE_URL=https://demo.playwright.dev

# Test Credentials
TEST_USERNAME=testuser
TEST_PASSWORD=testpassword

# Optional: Specific browser to run
# BROWSER=chromium

# Optional: Headed mode (show browser)
# HEADED=true

# Optional: Slow down operations (in milliseconds)
# SLOWMO=100
